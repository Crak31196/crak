{
  "rules": {
    "game": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false
    },
    "players": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','name']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20"
      }
    },
    "answers": {
      ".read": true,
      "$riddle": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['uid','name','clickedAt']) && newData.child('uid').val() === auth.uid && newData.child('name').isString()",
          "confirmed": {
            ".write": "auth != null && auth.uid === $uid"
          },
          "confirmedAt": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "winners": {
      ".read": true,
      "$riddle": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['uid','name','clickedAt']) && newData.child('uid').val() === auth.uid"
      }
    },
    "balloons": {
      ".read": true,
      "riddle$n": {
        ".write": "auth != null && !data.exists() && root.child('winners').child('riddle' + $n).child('uid').val() === auth.uid",
        ".validate": "newData.child('state').val() === 'popped' && newData.child('winnerUid').val() === auth.uid"
      },
      "final": {
        ".write": "auth != null && !data.exists() && root.child('finalWinner').child('uid').val() === auth.uid",
        ".validate": "newData.child('state').val() === 'popped' && newData.child('winnerUid').val() === auth.uid"
      }
    },
    "finalWinner": {
      ".read": true,
      ".write": "auth != null && !data.exists()"
    }
  }
}