{
  "rules": {
    "game": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "players": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','name']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20"
      }
    },
    "answers": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$riddle": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','name','clickedAt']) && newData.child('uid').val() === auth.uid && newData.child('name').isString()"
        }
      }
    },
    "winners": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$riddle": {
        ".write": "auth != null && !data.exists() && !root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['uid','name','clickedAt']) && newData.child('uid').val() === auth.uid"
      }
    },
    "balloons": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "final": {
        ".write": "auth != null && !data.exists() && root.child('finalWinner').child('uid').val() === auth.uid && !root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.child('state').val() === 'popped' && newData.child('winnerUid').val() === auth.uid"
      },
      "$riddle": {
        ".write": "auth != null && !data.exists() && root.child('winners').child($riddle).child('uid').val() === auth.uid && !root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.child('state').val() === 'popped' && newData.child('winnerUid').val() === auth.uid"
      }
    },
    "finalWinner": {
      ".read": true,
      ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).exists())"
    }
  }
}