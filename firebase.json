{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "firestore.rules",
      ".github/**",
      "node_modules/**",
      "README.md",
      ".gitignore"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=0, no-cache" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
